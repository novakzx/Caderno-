        <file alias="turmas.svg">icons/turmas.svg</file>
        <file alias="notas.svg">icons/notas.svg</file>
        <file alias="frequencia.svg">icons/frequencia.svg</file>
        <file alias="horario.svg">icons/horario.svg</file>
        <file alias="aulas.svg">icons/aulas.svg</file>
        <file alias="anotacoes.svg">icons/anotacoes.svg</file>
        <file alias="tarefas.svg">icons/tarefas.svg</file>
        <file alias="calendario.svg">icons/calendario.svg</file>
        <file alias="relatorios.svg">icons/relatorios.svg</file>
        <file alias="busca.svg">icons/busca.svg</file>
        <file alias="backup.svg">icons/backup.svg</file>
        <file alias="lua.svg">icons/lua.svg</file>
        <file alias="sol.svg">icons/sol.svg</file>
